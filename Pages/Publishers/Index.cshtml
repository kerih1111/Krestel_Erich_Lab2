@page
@model Krestel_Erich_Lab2.Pages.PublicatorPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Publicator[0].PublisherName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Publicator[0].Books)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Publicator) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PublisherName)
            </td>
            <td>
                @(item.Books != null && item.Books.Any() 
                    ? string.Join(", ", item.Books.Select(b => b.Title)) 
                    : "-")
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
